# Google Analytics 4 Measurement ID (Optional)
# Format: G-XXXXXXXXXX
# If left empty, analytics tracking will remain completely disabled without errors.
VITE_GA_MEASUREMENT_ID=

# Formspree endpoint for Briefing Requests & Contact Form
# Get your form ID at https://formspree.io/
# Conventional Vite prefix:
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
# Next.js compatibility prefix (supported via envPrefix in vite.config.ts):
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
